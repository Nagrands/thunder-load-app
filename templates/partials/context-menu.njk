          <li role="none">
            <button
              id="delete-file"
              class="context-menu__item context-menu__item--danger"
              aria-describedby="context-delete-file-description"
              type="button"
              role="menuitem"
            >
              <span class="cm-icon" aria-hidden="true">
                <i class="fa-solid fa-trash"></i>
              </span>
              <span class="cm-copy">
                <span class="cm-title" data-i18n="context.deleteFile"
                  >Удалить файл</span
                >
                <span
                  id="context-delete-file-description"
                  class="cm-description"
                  data-i18n="context.deleteFileDesc"
                  >Удалить физически с диска</span
                >
              </span>
            </button>
