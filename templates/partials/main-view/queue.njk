            <span class="queue-pill-count" data-queue-filter-count>0</span>
          </button>
          <button type="button" id="queue-count" class="queue-count-pill queue-count-pill--pending hidden" data-queue-filter="pending" aria-pressed="false">
            <span data-i18n="queue.filter.pending">Ожидают</span>
            <span class="queue-pill-count" data-queue-filter-count>0</span>
          </button>
          <button type="button" id="queue-error-count" class="queue-count-pill queue-count-pill--error hidden" data-queue-filter="error" aria-pressed="false">
