            <span class="queue-pill-count" data-queue-filter-count>0</span>
          </button>
          <button type="button" id="queue-done-count" class="queue-count-pill queue-count-pill--done hidden" data-queue-filter="done" aria-pressed="false">
            <span data-i18n="queue.filter.done">Готово</span>
            <span class="queue-pill-count" data-queue-filter-count>0</span>
          </button>
        </div>
      </div>
      <div class="queue-actions">
        <button
