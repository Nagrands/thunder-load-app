  <section class="downloads-toolbar" aria-label="Быстрый доступ" data-i18n-aria="downloader.quickAccess.title">
    <div class="downloads-toolbar__title">
      <span aria-hidden="true"><i data-lucide="download"></i></span>
      <strong data-i18n="downloader.quickAccess.title">Быстрый доступ</strong>
    </div>
    <div class="downloads-toolbar__actions">
      <button
        id="open-last-video"
        data-shortcut-action="downloads.last.open"
        class="queue-action-button queue-action-button--ghost"
        aria-label="Открыть последнее скачанное видео"
        data-i18n-aria="actions.openLast"
        title="Последнее видео"
        data-i18n-title="actions.lastVideo"
        disabled
      >
        <i class="fa fa-play" aria-hidden="true"></i>
        <span data-i18n="actions.lastVideo">Последнее видео</span>
      </button>
      <button
        id="open-history"
        data-shortcut-action="history.open"
        class="queue-action-button queue-action-button--ghost downloads-toolbar__history"
        type="button"
        aria-label="Открыть историю загрузок"
        data-i18n-aria="topbar.history"
        aria-controls="history-container"
        aria-expanded="false"
        data-bs-toggle="tooltip"
        data-bs-placement="top"
        title="История загрузок"
        data-i18n-title="topbar.history"
      >
        <i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i>
        <span data-i18n="history.title">История</span>
        <span id="downloads-history-count" class="downloads-toolbar__count" aria-hidden="true">0</span>
        <span
          id="downloads-history-new"
          class="downloads-toolbar__new hidden"
          data-i18n="downloader.quickAccess.new"
          aria-hidden="true"
        >Новое</span>
      </button>
      <span
        id="downloads-history-live"
        class="sr-only"
        role="status"
        aria-live="polite"
        aria-atomic="true"
      ></span>
    </div>
  </section>

  <div id="download-queue-info" class="download-queue-info hidden">
    <div class="queue-header">
      <div class="queue-header-left">
        <span class="queue-title-icon" aria-hidden="true"><i data-lucide="list-video"></i></span>
        <h3 class="queue-title">
          <span data-i18n="queue.title">Очередь</span>
          <span id="queue-total-count" class="queue-title-count" aria-live="polite">(0)</span>
        </h3>
      </div>
      <div class="queue-actions">
        <button
          id="download-cancel"
          class="queue-action-button queue-action-button--danger"
          aria-label="Отменить скачивание"
          data-i18n-aria="actions.cancelDownload"
          title="Отменить скачивание"
          data-i18n-title="actions.cancelDownload"
          disabled
        >
          <i data-lucide="square-x"></i>
          <span id="download-cancel-count" class="cancel-count hidden">0</span>
        </button>
        <button
          id="queue-start-button"
          class="queue-action-button queue-action-button--start"
          aria-label="Запустить очередь"
          title="Запустить очередь"
          data-i18n-title="queue.start.title"
          data-i18n-aria="queue.start.title"
        >
          <i data-lucide="play"></i>
          <span data-i18n="queue.start">Запустить</span>
        </button>
        <button
          id="queue-pause-button"
          class="queue-action-button queue-action-button--pause"
          aria-label="Не запускать следующие"
          title="Не запускать следующие"
          data-i18n-title="queue.pause.title"
          data-i18n-aria="queue.pause.title"
        >
          <i data-lucide="pause"></i>
        </button>
        <button
          id="queue-retry-failed-button"
          class="queue-action-button queue-action-button--ghost hidden"
          aria-label="Повторить все ошибки"
          title="Повторить все ошибки"
          data-i18n-title="queue.retryFailed.title"
          data-i18n-aria="queue.retryFailed.title"
        >
          <i data-lucide="refresh-cw"></i>
        </button>
        <button
          id="queue-clear-button"
          class="queue-action-button queue-action-button--clear"
          aria-label="Очистить очередь"
          title="Очистить очередь"
          data-i18n-title="queue.clear.title"
          data-i18n-aria="queue.clear.title"
        >
          <i data-lucide="trash-2"></i>
        </button>
        <span class="queue-actions-divider" aria-hidden="true"></span>
        <button
          id="queue-toggle-button"
          class="queue-toggle-button"
          aria-label="Свернуть очередь"
          title="Свернуть очередь"
          data-i18n-title="queue.toggle.collapse.title"
          data-i18n-aria="queue.toggle.collapse.title"
        >
          <i data-lucide="chevron-up"></i>
        </button>
      </div>
    </div>

    <div id="queue-list" class="queue-list" aria-live="off" role="list">
      <div class="queue-empty">
        <span class="queue-empty-icon" aria-hidden="true"><i data-lucide="inbox"></i></span>
        <p class="queue-empty-title" data-i18n="queue.empty.title">Очередь пуста</p>
        <p class="queue-empty-hint" data-i18n="queue.empty.hint">Добавьте URL выше, чтобы начать.</p>
      </div>
    </div>
  </div>

<div
  id="queue-start-indicator"
  class="queue-start-indicator hidden"
  data-i18n="queue.loading"
>
  ⏳ Загрузка из очереди...
</div>
