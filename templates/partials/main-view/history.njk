<!-- History Section -->
<section id="history-container">
  <div class="history-area" aria-live="polite">
    <div class="history-panel-shell">
      <div class="history-toolbar">
        <div class="history-toolbar__identity">
          <div class="history-toolbar__icon" aria-hidden="true">
            <i data-lucide="history"></i>
          </div>
          <div class="history-toolbar__title">
            <p class="history-toolbar__subtitle" data-i18n="history.subtitle">
              Недавние загрузки
            </p>
            <h3 class="history-toolbar__heading" data-i18n="history.title">История</h3>
          </div>
        </div>
        <div class="history-actions-card">
          <div class="history-deck-actions">
            <div class="history-action-segment history-action-segment--view">
              <div
                id="history-header"
                class="history-count-pill"
                aria-label="Количество записей"
                data-hint="Количество записей"
                data-i18n-aria="history.count"
                data-i18n-hint="history.count"
              >
                <i data-lucide="list-todo"></i>
                <span id="total-downloads">0</span>
                <span id="total-downloads-label" data-i18n="history.files.many">файлов</span>
                <span class="history-count-pill__divider" aria-hidden="true"></span>
                <i data-lucide="hard-drive"></i>
                <span id="total-download-size">0 MB</span>
                <span id="total-download-size-label" data-i18n="history.stats.size">занято</span>
              </div>
              <button
                id="refresh-button"
                class="history-action-button"
                aria-label="Обновить список"
                data-hint="Обновить список"
                data-i18n-aria="history.refresh"
                data-i18n-hint="history.refresh"
              >
                <i data-lucide="refresh-cw"></i>
              </button>
              <button
                id="sort-button"
                class="history-action-button"
                aria-label="Сортировка"
                data-hint="Сменить порядок сортировки"
                data-i18n-aria="history.sort"
                data-i18n-hint="history.sortHint"
              >
                <i data-lucide="arrow-down-wide-narrow"></i>
              </button>
            </div>

            <div class="history-action-segment history-action-segment--danger">
              <button
                id="clear-history"
                data-shortcut-action="history.clear"
                class="history-action-button"
                aria-label="Очистить историю"
                data-hint="Очистить всю историю"
                data-i18n-aria="history.clear"
                data-i18n-hint="history.clearHint"
              >
                <i data-lucide="trash"></i>
              </button>
            </div>

            <div class="history-action-segment history-action-segment--more">
              <button
                id="history-more-trigger"
                class="history-action-button history-more-trigger"
                type="button"
                aria-label="Дополнительные действия"
                data-i18n-aria="history.action.more"
                aria-haspopup="true"
                aria-expanded="false"
                aria-controls="history-more-menu"
                data-hint="Дополнительные действия"
                data-i18n-hint="history.action.more"
              >
                <i data-lucide="ellipsis"></i>
              </button>
              <div id="history-more-menu" class="history-more-menu hidden" role="menu">
                <button
                  id="restore-history"
                  class="history-more-menu__item"
                  type="button"
                  role="menuitem"
                  aria-label="Восстановить удалённые записи"
                  data-i18n-aria="history.restore"
                >
                  <i data-lucide="undo-2"></i>
                  <span data-i18n="history.restore">Восстановить удалённые записи</span>
                </button>
                <button
                  id="history-export-json"
                  class="history-more-menu__item"
                  type="button"
                  role="menuitem"
                  aria-label="Экспорт в JSON"
                  data-i18n-aria="history.exportJson"
                >
                  <i data-lucide="file-json"></i>
                  <span data-i18n="history.exportJson">Экспорт в JSON</span>
                </button>
                <button
                  id="history-export-csv"
                  class="history-more-menu__item"
                  type="button"
                  role="menuitem"
                  aria-label="Экспорт в CSV"
                  data-i18n-aria="history.exportCsv"
                >
                  <i data-lucide="file-spreadsheet"></i>
                  <span data-i18n="history.exportCsv">Экспорт в CSV</span>
                </button>
                <button
                  id="history-density-compact"
                  class="history-more-menu__item"
                  type="button"
                  role="menuitem"
                  aria-label="Компактно"
                  data-i18n-aria="history.density.compact"
                >
                  <i data-lucide="rows-3"></i>
                  <span data-i18n="history.density.compact">Компактно</span>
                </button>
                <button
                  id="history-density-comfort"
                  class="history-more-menu__item"
                  type="button"
                  role="menuitem"
                  aria-label="Подробный"
                  data-i18n-aria="history.density.comfort"
                >
                  <i data-lucide="panel-top-open"></i>
                  <span data-i18n="history.density.comfort">Подробный</span>
                </button>
                <button
                  id="toggle-all-details"
                  class="history-more-menu__item"
                  type="button"
                  role="menuitem"
                  aria-label="Развернуть все"
                  data-i18n-aria="history.details.toggleAll"
                >
                  <i data-lucide="chevron-down"></i>
                  <span data-i18n="history.details.toggleAll">Развернуть все</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="history-controls">
        <div class="history-search-filters-card">
          <div class="history-controls-row history-controls-row--primary history-controls-row--search-filter">
            <div class="history-search-card">
              <div class="history-search-wrapper history-input-wrapper">
                <i id="icon-filter-search" class="search-icon" data-lucide="search"></i>
                <input
                  type="text"
                  id="filter-input"
                  placeholder="Поиск по истории"
                  aria-label="Поиск по истории"
                  data-i18n-placeholder="history.search.placeholder"
                  data-i18n-aria="history.search.aria"
                />
                <button
                  id="clear-filter-input"
                  class="history-action-button hidden"
                  aria-label="Очистить поиск"
                  data-hint="Сбросить поисковый запрос"
                  data-i18n-aria="history.search.clear"
                  data-i18n-hint="history.search.clearHint"
                >
                  <i data-lucide="x"></i>
                </button>
              </div>
            </div>
          </div>

          <div class="history-controls-row history-controls-row--filters history-filters-row">
            <div class="history-filters-card" id="history-filters-card">
              <div class="history-filters-head">
                <button
                  id="history-filters-toggle"
                  class="history-filters-toggle"
                  type="button"
                  aria-expanded="true"
                  aria-controls="history-filters-body"
                  data-i18n-aria="history.filters.toggle"
                >
                  <span class="history-filters-title" data-i18n="history.filters.title">Фильтры</span>
                  <i data-lucide="chevron-up"></i>
                </button>
                <div class="history-filters-head-actions">
                  <span
                    id="history-active-filters-count"
                    class="history-active-filters-count hidden"
                    aria-live="polite"
                  ></span>
                  <button
                    id="history-reset-filters"
                    class="history-filter-reset hidden"
                    type="button"
                    aria-label="Сбросить фильтры"
                    title="Сбросить активные фильтры"
                    data-bs-toggle="tooltip"
                    data-bs-placement="top"
                    data-hint="Сбросить активные фильтры"
                    data-i18n-aria="history.filters.reset"
                    data-i18n-title="history.filters.resetHint"
                    data-i18n-hint="history.filters.resetHint"
                  >
                    <i data-lucide="rotate-ccw"></i>
                  </button>
                </div>
              </div>
              <div id="history-filters-body" class="history-filters-body">
                <div class="history-filter-group">
                  <div class="history-filter-pill history-filter-pill--status">
                    <i data-lucide="circle-check-big"></i>
                    <div class="history-filter-meta">
                      <span data-i18n="history.filter.status.label">Состояние</span>
                      <select
                        id="history-status-filter"
                        class="history-filter-select"
                        aria-label="Фильтр по состоянию"
                        data-i18n-aria="history.filter.status.label"
                      >
                        <option value="all" data-icon="lucide:list-filter" data-i18n="history.filter.status.all">Все</option>
                        <option value="available" data-icon="lucide:circle-check-big" data-i18n="history.filter.status.available">Доступные</option>
                        <option value="missing" data-icon="lucide:file-x-2" data-i18n="history.filter.status.missing">Файл удалён</option>
                        <option value="error" data-icon="lucide:circle-alert" data-i18n="history.filter.status.error">Ошибки</option>
                      </select>
                    </div>
                  </div>
                  <div class="history-filter-pill">
                    <i data-lucide="globe"></i>
                    <div class="history-filter-meta">
                      <span data-i18n="history.filter.source.label">Источник</span>
                      <select
                        id="history-source-filter"
                        class="history-filter-select"
                        aria-label="Фильтр по источнику"
                        data-i18n-aria="history.filter.source"
                      >
                        <option
                          value=""
                          data-icon="lucide:globe"
                          data-i18n="history.filter.source.all"
                        >
                          Все источники
                        </option>
                      </select>
                    </div>
                  </div>
                  <div class="history-filter-pill">
                    <i data-lucide="arrow-up-wide-narrow"></i>
                    <div class="history-filter-meta">
                      <span data-i18n="history.sort.by.label">Сортировка</span>
                      <select
                        id="history-sort-key"
                        class="history-filter-select"
                        aria-label="Сортировка"
                        data-i18n-aria="history.sort.by.label"
                      >
                        <option value="date" data-icon="lucide:calendar-days" data-i18n="history.sort.by.date">
                          По дате
                        </option>
                        <option value="size" data-icon="lucide:hard-drive" data-i18n="history.sort.by.size">
                          По размеру
                        </option>
                        <option value="quality" data-icon="lucide:sliders-horizontal" data-i18n="history.sort.by.quality">
                          По качеству
                        </option>
                        <option value="source" data-icon="lucide:globe" data-i18n="history.sort.by.source">
                          По источнику
                        </option>
                      </select>
                    </div>
                  </div>
                  <div class="history-filter-pill history-filter-pill--type">
                    <i data-lucide="layers-3"></i>
                    <div class="history-filter-meta">
                      <div class="history-filter-label">
                        <span data-i18n="history.sort.mode.label">Тип</span>
                      </div>
                      <select
                        id="history-sort-mode"
                        class="history-filter-select"
                        aria-label="Тип медиа"
                        data-i18n-aria="history.sort.mode.label"
                      >
                        <option value="video" data-icon="lucide:film" data-i18n="history.sort.mode.video">
                          Видео
                        </option>
                        <option value="audio" data-icon="lucide:music-2" data-i18n="history.sort.mode.audio">
                          Аудио
                        </option>
                        <option value="mixed" data-icon="lucide:layers-3" data-i18n="history.sort.mode.mixed">
                          Смешано
                        </option>
                      </select>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>

      <div id="history-bulk-bar" class="history-bulk-bar hidden">
        <div class="history-bulk-info">
          <i data-lucide="check-square"></i>
          <span data-i18n="history.bulk.selected">Выбрано</span>
          <span id="history-selected-count">0</span>
          <button
            id="history-clear-selection"
            class="history-bulk-clear"
            type="button"
            aria-label="Снять выделение"
            data-i18n-aria="history.bulk.clear"
            data-i18n="history.bulk.clear"
          >
            Снять выделение
          </button>
        </div>
        <div class="history-bulk-actions" role="toolbar" aria-label="Массовые действия" data-i18n-aria="history.bulk.actions">
          <button id="history-select-page" class="history-bulk-action" type="button" data-i18n="history.bulk.selectPage">Выбрать страницу</button>
          <button id="history-select-filtered" class="history-bulk-action" type="button" title="Поиск не влияет на область выбора" data-i18n="history.bulk.selectFiltered" data-i18n-title="history.bulk.selectFilteredHint">Выбрать все результаты фильтра</button>
          <button id="history-export-selected-json" class="history-bulk-action" type="button" aria-label="Экспортировать выбранные в JSON" data-i18n-aria="history.bulk.exportJson">
            <i data-lucide="file-json"></i><span>JSON</span>
          </button>
          <button id="history-export-selected-csv" class="history-bulk-action" type="button" aria-label="Экспортировать выбранные в CSV" data-i18n-aria="history.bulk.exportCsv">
            <i data-lucide="file-spreadsheet"></i><span>CSV</span>
          </button>
          <button id="delete-selected" class="history-bulk-action history-bulk-action--danger" type="button" aria-label="Удалить выбранные записи" data-i18n-aria="history.deleteSelected">
            <i data-lucide="trash-2"></i><span data-i18n="history.bulk.delete">Удалить выбранные</span>
          </button>
        </div>
      </div>

      <div id="history" class="history-list" role="list"></div>
      <div id="history-empty" class="history-empty">
        <p id="history-empty-message" data-i18n="history.empty">Список пуст</p>
        <button id="history-empty-reset-search" class="history-empty-action hidden" type="button" data-i18n="history.search.reset">
          Сбросить поиск
        </button>
      </div>

      <div id="history-pagination" class="history-pagination" data-ui="history-pagination">
        <div class="history-page-side history-page-side--left">
          <button
            type="button"
            class="history-action-button history-page-btn"
            id="history-page-prev-fast"
            aria-label="Назад на 5 страниц"
            data-i18n-aria="history.pagination.prevFastAria"
          >
            <i data-lucide="chevrons-left"></i>
          </button>
          <button
            type="button"
            class="history-action-button history-page-btn"
            id="history-page-prev"
            aria-label="Предыдущая страница"
            data-i18n-aria="history.pagination.prevAria"
          >
            <i data-lucide="chevron-left"></i>
          </button>
        </div>
        <div class="history-page-center">
          <span class="history-page-info" id="history-page-info" aria-live="polite">
            Страница 1 из 1 · 0 записей
          </span>
          <label class="history-page-size">
            <span class="history-page-size-label" data-i18n="history.pagination.perLabel">по</span>
            <select
              id="history-page-size"
              class="input input-sm history-page-size-select bk-select-init"
              aria-label="Записей на странице"
              data-i18n-aria="history.pagination.perAria"
            >
              <option value="4">4</option>
              <option value="10">10</option>
              <option value="20">20</option>
            </select>
          </label>
        </div>
        <div class="history-page-side history-page-side--right">
          <button
            type="button"
            class="history-action-button history-page-btn"
            id="history-page-next"
            aria-label="Следующая страница"
            data-i18n-aria="history.pagination.nextAria"
          >
            <i data-lucide="chevron-right"></i>
          </button>
          <button
            type="button"
            class="history-action-button history-page-btn"
            id="history-page-next-fast"
            aria-label="Вперёд на 5 страниц"
            data-i18n-aria="history.pagination.nextFastAria"
          >
            <i data-lucide="chevrons-right"></i>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>
