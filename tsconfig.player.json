{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "electron"]
  },
  "include": [
    "src/js/modules/nowPlaying/**/*.js",
    "src/js/app/nowPlaying*.js",
    "src/js/app/mediaOpenService.js"
  ],
  "exclude": ["**/__tests__/**"]
}
