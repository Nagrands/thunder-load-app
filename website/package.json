{
  "name": "thunder-official-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check && cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:links": "node scripts/check-built-site.mjs",
    "test:downloads": "node scripts/smoke-downloads.mjs",
    "test:lighthouse": "node scripts/run-lighthouse.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.5",
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "3.7.3",
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.1.6",
    "gsap": "3.15.0",
    "@lucide/astro": "1.27.0",
    "marked": "^16.4.1",
    "sanitize-html": "^2.17.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.62.0",
    "@types/node": "^24.10.1",
    "@types/sanitize-html": "^2.16.0",
    "chrome-launcher": "1.2.1",
    "cross-env": "10.1.0",
    "lighthouse": "13.4.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.10"
  }
}
