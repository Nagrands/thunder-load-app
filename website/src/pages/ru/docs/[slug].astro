---
import { getCollection, render } from "astro:content";
import ContentLayout from "@/layouts/ContentLayout.astro";
import { contentSlug } from "@/i18n";

export async function getStaticPaths() {
  const entries = await getCollection("docs", ({ data }) => data.locale === "ru" && !data.draft);
  return entries.map((entry) => ({ params: { slug: contentSlug(entry.id) }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: entry.data.title,
  description: entry.data.description,
  inLanguage: "ru-RU",
  author: { "@type": "Organization", name: "NGR Software" }
};
---
<ContentLayout locale="ru" title={entry.data.title} description={entry.data.description} eyebrow="Документация" updatedAt={entry.data.updatedAt} jsonLd={jsonLd}>
  <Content />
</ContentLayout>
