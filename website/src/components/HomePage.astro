---
import { Picture } from "astro:assets";
import {
  ArrowRight,
  Boxes,
  Clock3,
  Cloud,
  Download,
  Film,
  Gauge,
  GitFork,
  Headphones,
  Library,
  MonitorCog,
  Music2,
  Play,
  ScanLine,
  Sparkles,
  WandSparkles,
  Zap
} from "@lucide/astro";
import heroImage from "@/assets/screenshots/thunder-download.png";
import type { Locale } from "@/config/site";
import { platforms, SITE, supportedServices } from "@/config/site";
import type { Release } from "@/lib/releases";
import { localizedUrl } from "@/lib/urls";
import ScreenshotGallery from "@/components/ScreenshotGallery.astro";
import DownloadPanel from "@/components/DownloadPanel.astro";
import ReleaseCard from "@/components/ReleaseCard.astro";

interface Props {
  locale: Locale;
  releases: Release[];
}

const { locale, releases } = Astro.props;
const latest = releases[0];
const isRu = locale === "ru";

const copy = isRu ? {
  heroBadge: `Thunder ${latest.version} уже доступен`,
  heroTitle: "Ваши медиа.",
  heroAccent: "На ваших условиях.",
  heroLead: "Thunder объединяет загрузчик, медиаплеер, конвертер и полезные инструменты в одном быстром приложении для Windows и macOS.",
  download: "Скачать Thunder",
  docs: "Документация",
  trusted: "Прямые загрузки из GitHub",
  noTracking: "Без рекламы и трекеров",
  featuresEyebrow: "Всё необходимое",
  featuresTitle: "Один центр для работы с медиа",
  featuresLead: "От ссылки до готового файла — Thunder берёт на себя загрузку, обработку, воспроизведение и организацию.",
  galleryEyebrow: "Настоящий интерфейс",
  galleryTitle: "Знакомый с первого запуска",
  galleryLead: "Чистый рабочий процесс, понятные состояния и полный контроль без перегруженных панелей.",
  productsEyebrow: "Больше, чем загрузчик",
  productsTitle: "Инструменты для каждого этапа",
  servicesTitle: "Работает с популярными сервисами",
  servicesLead: "Поддержка источников развивается вместе с yt-dlp. Расширенные превью ориентированы прежде всего на YouTube.",
  platformsTitle: "Thunder на вашей платформе",
  whatsNew: "Последние обновления",
  whatsNewLead: "История релизов синхронизируется с официальными публикациями на GitHub.",
  faqTitle: "Частые вопросы",
  questions: [
    ["Thunder бесплатный?", "Thunder распространяется через официальный GitHub-репозиторий. Условия лицензирования будут опубликованы отдельно."],
    ["Какие сайты поддерживаются?", "Thunder использует yt-dlp, поэтому фактический список источников зависит от его актуальной версии. Основные сценарии проверяются с YouTube, Twitch, VK Видео и Coub."],
    ["Почему macOS показывает предупреждение?", "Текущие сборки macOS не подписаны и не нотаризованы. Загружайте DMG только с официальной страницы релиза и проверяйте опубликованный SHA-256."],
    ["Когда появится Linux?", "AppImage уже можно собрать из исходников, но официальный автоматический Linux-релиз пока планируется."]
  ]
} : {
  heroBadge: `Thunder ${latest.version} is available`,
  heroTitle: "Your media.",
  heroAccent: "On your terms.",
  heroLead: "Thunder brings a downloader, media player, converter, and practical tools together in one fast app for Windows and macOS.",
  download: "Download Thunder",
  docs: "Documentation",
  trusted: "Direct downloads from GitHub",
  noTracking: "No ads or trackers",
  featuresEyebrow: "Everything you need",
  featuresTitle: "One place for every media workflow",
  featuresLead: "From a link to a finished file, Thunder handles downloading, processing, playback, and organization.",
  galleryEyebrow: "The real interface",
  galleryTitle: "Familiar from the first launch",
  galleryLead: "A clean workflow, clear states, and full control without cluttered panels.",
  productsEyebrow: "More than a downloader",
  productsTitle: "Tools for every stage",
  servicesTitle: "Works with popular services",
  servicesLead: "Source support evolves with yt-dlp. Advanced previews are optimized primarily for YouTube.",
  platformsTitle: "Thunder on your platform",
  whatsNew: "Latest updates",
  whatsNewLead: "Release history stays in sync with official GitHub publications.",
  faqTitle: "Frequently asked questions",
  questions: [
    ["Is Thunder free?", "Thunder is distributed through the official GitHub repository. Licensing terms will be published separately."],
    ["Which sites are supported?", "Thunder uses yt-dlp, so the effective source list depends on its current version. Core flows are checked with YouTube, Twitch, VK Video, and Coub."],
    ["Why does macOS show a warning?", "Current macOS builds are not signed or notarized. Download the DMG only from the official release and verify the published SHA-256."],
    ["When is Linux coming?", "An AppImage can already be built from source, but an official automated Linux release is still planned."]
  ]
};

const highlights = [
  { icon: Download, ru: ["Загрузчик", "Видео, аудио, субтитры и плейлисты с выбором качества до запуска."], en: ["Downloader", "Video, audio, subtitles, and playlists with quality selection before download."] },
  { icon: Play, ru: ["Медиаплеер", "Локальные файлы, YouTube, HLS, очереди и плейлисты в неблокирующем плеере."], en: ["Media player", "Local files, YouTube, HLS, queues, and playlists in a non-blocking player."] },
  { icon: Music2, ru: ["Now Playing", "Системные media keys, метаданные и управление воспроизведением."], en: ["Now Playing", "System media keys, metadata, and playback control."] },
  { icon: WandSparkles, ru: ["Конвертация", "Преобразование аудио и видео через управляемый FFmpeg."], en: ["Conversion", "Audio and video conversion powered by managed FFmpeg."] }
];

const productCards = [
  { icon: Zap, ru: ["Загрузчик", "Очередь, качества, субтитры и быстрые действия."], en: ["Downloader", "Queue, quality choices, subtitles, and quick actions."] },
  { icon: Film, ru: ["Конвертер", "Готовые форматы и точный контроль результата."], en: ["Converter", "Practical presets and precise output control."] },
  { icon: Headphones, ru: ["Медиаплеер", "Видео, музыка, HLS и несколько аудиодорожек."], en: ["Media player", "Video, music, HLS, and multiple audio tracks."] },
  { icon: Boxes, ru: ["Инструменты", "Хеши, Media Inspector, сортировщик и Backup."], en: ["Tools", "Hashes, Media Inspector, file sorting, and Backup."] },
  { icon: Cloud, ru: ["Веб-интерфейс", "Удалённый доступ к основным сценариям загрузки."], en: ["Web interface", "Remote access to essential download workflows."] },
  { icon: Clock3, ru: ["История", "Поиск, фильтры, повтор и экспорт операций."], en: ["History", "Search, filters, repeat actions, and export."] },
  { icon: Library, ru: ["Медиатека", "Плейлисты, очередь «Далее» и локальные папки."], en: ["Library", "Playlists, an Up Next queue, and local folders."] },
  { icon: MonitorCog, ru: ["Система", "Tray, Dock, ассоциации файлов и горячие клавиши."], en: ["System", "Tray, Dock, file associations, and shortcuts."] }
];

const softwareJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Thunder",
  alternateName: ["ThunderLoad", "Thunder Load"],
  applicationCategory: "MultimediaApplication",
  operatingSystem: "Windows 10, Windows 11, macOS 12 or later",
  softwareVersion: latest.version,
  datePublished: latest.publishedAt,
  downloadUrl: new URL(localizedUrl(locale, "download"), Astro.site).toString(),
  url: new URL(localizedUrl(locale), Astro.site).toString(),
  author: { "@type": "Organization", name: SITE.author },
  description: copy.heroLead
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: copy.questions.map(([name, text]) => ({
    "@type": "Question",
    name,
    acceptedAnswer: { "@type": "Answer", text }
  }))
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify([softwareJsonLd, faqJsonLd])} />

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <a href={localizedUrl(locale, "releases")} class="release-pill">
        <Sparkles size={15} /> {copy.heroBadge} <ArrowRight size={15} />
      </a>
      <h1>{copy.heroTitle}<br /><span class="gradient-text">{copy.heroAccent}</span></h1>
      <p>{copy.heroLead}</p>
      <div class="hero-actions">
        <a class="button button-primary" href={localizedUrl(locale, "download")}><Download size={20} /> {copy.download}</a>
        <a class="button" href={SITE.repository} target="_blank" rel="noreferrer"><GitFork size={19} /> GitHub</a>
        <a class="button button-ghost" href={localizedUrl(locale, "docs")}>{copy.docs} <ArrowRight size={17} /></a>
      </div>
      <div class="hero-trust">
        <span><ScanLine size={16} /> {copy.trusted}</span>
        <span><Gauge size={16} /> {copy.noTracking}</span>
      </div>
    </div>
    <div class="hero-visual" data-parallax>
      <div class="app-frame glass">
        <div class="window-bar"><span></span><span></span><span></span><small>THUNDER</small></div>
        <Picture
          src={heroImage}
          alt={isRu ? "Интерфейс загрузчика Thunder" : "Thunder downloader interface"}
          widths={[640, 960, 1400]}
          sizes="(max-width: 900px) 92vw, 55vw"
          formats={["avif", "webp"]}
          loading="eager"
          fetchpriority="high"
          quality={84}
        />
      </div>
      <div class="hero-orbit orbit-one"></div>
      <div class="hero-orbit orbit-two"></div>
    </div>
  </div>
</section>

<section class="section" id="features">
  <div class="container">
    <div class="section-heading reveal">
      <p class="eyebrow">{copy.featuresEyebrow}</p>
      <h2>{copy.featuresTitle}</h2>
      <p>{copy.featuresLead}</p>
    </div>
    <div class="highlights-grid">
      {highlights.map((item) => {
        const [title, description] = item[locale];
        const Icon = item.icon;
        return (
          <article class="feature-card glass reveal">
            <div class="icon-box"><Icon size={23} /></div>
            <h3>{title}</h3>
            <p>{description}</p>
          </article>
        );
      })}
    </div>
  </div>
</section>

<section class="section interface-section">
  <div class="container">
    <div class="section-heading reveal">
      <p class="eyebrow">{copy.galleryEyebrow}</p>
      <h2>{copy.galleryTitle}</h2>
      <p>{copy.galleryLead}</p>
    </div>
    <ScreenshotGallery locale={locale} />
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-heading reveal">
      <p class="eyebrow">{copy.productsEyebrow}</p>
      <h2>{copy.productsTitle}</h2>
    </div>
    <div class="product-grid">
      {productCards.map((item) => {
        const [title, description] = item[locale];
        const Icon = item.icon;
        return (
          <article class="product-card glass reveal">
            <Icon size={25} />
            <div><h3>{title}</h3><p>{description}</p></div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<section class="section ecosystem-section">
  <div class="container ecosystem-grid">
    <div class="reveal">
      <p class="eyebrow">yt-dlp</p>
      <h2>{copy.servicesTitle}</h2>
      <p>{copy.servicesLead}</p>
      <div class="service-grid">
        {supportedServices.map((service) => (
          <div class={`service service-${service.id}`}>
            <span>{service.mark}</span><strong>{service.name}</strong>
          </div>
        ))}
      </div>
    </div>
    <div class="reveal">
      <p class="eyebrow">{isRu ? "Доступность" : "Availability"}</p>
      <h2>{copy.platformsTitle}</h2>
      <div class="platform-stack">
        {platforms.map((platform) => (
          <article class="platform-card glass">
            <div>
              <strong>{platform.name}</strong>
              <span class:list={["status", platform.status]}>
                {platform.status === "supported" ? (isRu ? "Поддерживается" : "Supported") : (isRu ? "Планируется" : "Planned")}
              </span>
            </div>
            <small>{platform.requirements} · {platform.architectures.join(" / ")}</small>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <DownloadPanel locale={locale} release={latest} />
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-heading reveal">
      <p class="eyebrow">{isRu ? "Что нового" : "What’s new"}</p>
      <h2>{copy.whatsNew}</h2>
      <p>{copy.whatsNewLead}</p>
    </div>
    <div class="release-grid reveal">
      {releases.slice(0, 3).map((release, index) => <ReleaseCard locale={locale} release={release} featured={index === 0} />)}
    </div>
    <a class="text-link" href={localizedUrl(locale, "releases")}>
      {isRu ? "Посмотреть всю историю" : "View the full history"} <ArrowRight size={17} />
    </a>
  </div>
</section>

<section class="section" id="faq">
  <div class="container faq-grid">
    <div class="section-heading reveal">
      <p class="eyebrow">FAQ</p>
      <h2>{copy.faqTitle}</h2>
      <p>{isRu ? "Короткие ответы перед установкой. Подробности — в документации." : "Quick answers before installing. Find details in the documentation."}</p>
    </div>
    <div class="faq-list reveal">
      {copy.questions.map(([question, answer]) => (
        <details>
          <summary>{question}<span>+</span></summary>
          <p>{answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - var(--header-height));
    display: grid;
    align-items: center;
    padding: 80px 0 100px;
  }

  .hero::after {
    position: absolute;
    inset: auto 0 0;
    height: 220px;
    content: "";
    pointer-events: none;
    background: linear-gradient(transparent, #050914);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 0.92fr 1.08fr;
    align-items: center;
    gap: 54px;
  }

  .hero-copy {
    position: relative;
    z-index: 2;
  }

  .release-pill {
    display: inline-flex;
    margin-bottom: 30px;
    padding: 7px 12px;
    align-items: center;
    gap: 8px;
    border: 1px solid rgb(22 216 255 / 0.22);
    border-radius: 999px;
    color: #bff7ff;
    background: rgb(10 139 255 / 0.08);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .hero h1 {
    margin-bottom: 24px;
  }

  .hero-copy > p {
    max-width: 620px;
    font-size: clamp(1.05rem, 1.8vw, 1.22rem);
  }

  .hero-actions {
    display: flex;
    margin-top: 34px;
    flex-wrap: wrap;
    gap: 10px;
  }

  .hero-trust {
    display: flex;
    margin-top: 26px;
    flex-wrap: wrap;
    gap: 12px 22px;
    color: #7893b0;
    font-size: 0.78rem;
    font-weight: 650;
  }

  .hero-trust span {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .hero-visual {
    position: relative;
    z-index: 1;
    width: 120%;
  }

  .app-frame {
    position: relative;
    z-index: 2;
    padding: 8px;
    border-radius: 24px;
    transform: perspective(1200px) rotateY(-5deg) rotateX(2deg);
    box-shadow: 0 36px 120px rgb(0 0 0 / 0.48), 0 0 80px rgb(10 139 255 / 0.12);
  }

  .app-frame img {
    display: block;
    border-radius: 15px;
  }

  .window-bar {
    display: flex;
    height: 34px;
    align-items: center;
    padding: 0 9px;
    gap: 6px;
  }

  .window-bar span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #31425a;
  }

  .window-bar small {
    margin-inline: auto;
    color: #53708f;
    font-family: Orbitron, sans-serif;
    font-size: 0.53rem;
    letter-spacing: 0.14em;
  }

  .hero-orbit {
    position: absolute;
    z-index: -1;
    border: 1px solid rgb(22 216 255 / 0.13);
    border-radius: 50%;
  }

  .orbit-one {
    inset: -16% 6% -14% -6%;
  }

  .orbit-two {
    inset: -28% -6% -27% -18%;
    opacity: 0.5;
  }

  .highlights-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .interface-section {
    background: linear-gradient(180deg, transparent, rgb(10 139 255 / 0.025), transparent);
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }

  .product-card {
    display: flex;
    min-height: 170px;
    padding: 24px;
    flex-direction: column;
    justify-content: space-between;
    border-radius: 20px;
    color: #7be7ff;
  }

  .product-card h3 {
    margin: 24px 0 6px;
  }

  .product-card p {
    margin: 0;
    font-size: 0.9rem;
  }

  .ecosystem-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
  }

  .service-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: 32px;
    gap: 10px;
  }

  .service {
    display: flex;
    padding: 16px;
    align-items: center;
    gap: 12px;
    border: 1px solid rgb(133 201 255 / 0.13);
    border-radius: 15px;
    background: rgb(21 29 41 / 0.44);
  }

  .service span {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border-radius: 10px;
    color: #dffaff;
    background: rgb(45 156 255 / 0.15);
    font-size: 0.67rem;
    font-weight: 900;
  }

  .service strong {
    font-size: 0.9rem;
  }

  .platform-stack {
    display: grid;
    gap: 10px;
  }

  .platform-card {
    padding: 20px;
    border-radius: 17px;
  }

  .platform-card > div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .platform-card small {
    display: block;
    margin-top: 7px;
    color: #7c97b5;
  }

  .status {
    padding: 4px 8px;
    border-radius: 999px;
    font-size: 0.66rem;
    font-weight: 800;
  }

  .status.supported {
    color: #7dff9f;
    background: rgb(62 227 107 / 0.08);
  }

  .status.planned {
    color: #f6dc77;
    background: rgb(255 212 59 / 0.08);
  }

  .release-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  .text-link {
    display: inline-flex;
    margin-top: 24px;
    align-items: center;
    gap: 8px;
    color: #7be7ff;
    font-weight: 750;
  }

  .faq-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 80px;
  }

  .faq-list {
    display: grid;
    gap: 10px;
  }

  .faq-list details {
    border: 1px solid rgb(133 201 255 / 0.13);
    border-radius: 16px;
    background: rgb(15 23 36 / 0.62);
  }

  .faq-list summary {
    display: flex;
    padding: 20px;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    color: #eff8ff;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  .faq-list summary::-webkit-details-marker {
    display: none;
  }

  .faq-list summary span {
    color: #64d9ff;
    font-size: 1.25rem;
    transition: transform 180ms ease;
  }

  .faq-list details[open] summary span {
    transform: rotate(45deg);
  }

  .faq-list details p {
    margin: 0;
    padding: 0 20px 20px;
  }

  @media (max-width: 1050px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-visual {
      width: 100%;
    }

    .app-frame {
      transform: none;
    }

    .highlights-grid,
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 820px) {
    .ecosystem-grid,
    .faq-grid {
      grid-template-columns: 1fr;
      gap: 42px;
    }

    .release-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .hero {
      min-height: auto;
      padding-top: 56px;
    }

    .hero-actions {
      display: grid;
    }

    .highlights-grid,
    .product-grid,
    .service-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
