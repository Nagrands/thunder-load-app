---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="page-hero">
  <div class="container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    <p>{description}</p>
  </div>
</header>

<style>
  .page-hero {
    padding: 96px 0 58px;
  }

  .page-hero h1 {
    max-width: 900px;
    margin-bottom: 20px;
    font-size: clamp(2.6rem, 6vw, 4.7rem);
  }

  .page-hero p:not(.eyebrow) {
    max-width: 700px;
    font-size: 1.08rem;
  }
</style>
