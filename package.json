{
  "name": "thunder-app",
  "productName": "Thunder",
  "version": "1.6.0",
  "description": "Thunder Spark",
  "main": "src/js/app.js",
  "private": true,
  "scripts": {
    "predev": "npm run whats-new:build && npm run templates:build && npm run css:build",
    "dev": "electron . --dev",
    "dev:watch": "node scripts/dev-with-whatsnew.mjs",
    "prestart": "npm run whats-new:build && npm run templates:build && npm run css:build",
    "start": "electron .",
    "test": "node --disable-warning=ExperimentalWarning --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --no-cache",
    "build": "electron-builder",
    "build-linux": "electron-builder --linux AppImage",
    "build-mac": "electron-builder --mac",
    "whats-new:watch": "nodemon --watch whats-new.md --watch whats-new.en.md --ext md --exec \"npm run whats-new:build\"",
    "css:build": "sass src/scss:src/css",
    "tray-icons:build": "electron scripts/generate-windows-tray-icons.cjs",
    "css:watch": "sass --watch src/scss:src/css",
    "sass": "npm run css:watch",
    "fa:copy": "copyfiles -f node_modules/@fortawesome/fontawesome-free/webfonts/* src/assets/webfonts",
    "dompurify:copy": "copyfiles -f node_modules/dompurify/dist/purify.min.js assets/vendor/dompurify",
    "postinstall": "npm run fa:copy && npm run dompurify:copy",
    "prebuild": "npm run whats-new:build && npm run templates:build && npm run css:build && npm run fa:copy && npm run dompurify:copy",
    "templates:build": "node scripts/build-templates.mjs",
    "templates:watch": "nodemon --watch templates --ext njk --exec \"npm run templates:build\"",
    "test-check:sync": "npm run test-check:sync-tests && npm run test-check:summary",
    "test-check:sync-tests": "node scripts/sync-test-check-jest-list.mjs",
    "test-check:summary": "node scripts/update-test-check-summary.mjs",
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.cjs,.mjs --max-warnings 0",
    "check": "npm run lint && npm run typecheck:player && npm test",
    "typecheck:player": "tsc -p tsconfig.player.json",
    "dist": "electron-builder --publish always",
    "predist": "npm run whats-new:build && npm run css:build",
    "release:patch": "npm version patch -m \"chore(release): %s\" && git push && git push --tags",
    "release:minor": "npm version minor -m \"chore(release): %s\" && git push && git push --tags",
    "release:major": "npm version major -m \"chore(release): %s\" && git push && git push --tags",
    "tag:current": "node -e \"const v='v'+require('./package.json').version; const {execSync}=require('child_process'); execSync(`git tag ${v}`,{stdio:'inherit'}); execSync(`git push origin ${v}`,{stdio:'inherit'});\"",
    "whats-new:build": "node scripts/build-whats-new.mjs"
  },
  "dependencies": {
    "dompurify": "^3.2.5",
    "dotenv": "^17.2.3",
    "electron-log": "^5.4.3",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.3.3",
    "electron-window-state": "^5.0.3",
    "hls.js": "^1.6.16",
    "lucide": "^0.575.0",
    "marked": "^16.4.1",
    "sudo-prompt": "^9.2.1",
    "tree-kill": "^1.2.2",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@fortawesome/fontawesome-free": "^7.0.0",
    "babel-jest": "^30.2.0",
    "copyfiles": "^2.4.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.4.0",
    "electron-debug": "^4.0.0",
    "eslint": "^9.20.0",
    "globals": "^15.15.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "nodemon": "^3.1.11",
    "nunjucks": "^3.2.4",
    "prettier": "^3.3.3",
    "sass": "^1.32.8",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.thunderload.app",
    "productName": "Thunder",
    "asar": true,
    "extraResources": [
      {
        "from": "assets/icons/",
        "to": "usr/share/icons/hicolor/256x256/apps"
      }
    ],
    "files": [
      "bin/**/*",
      "assets/**/*",
      "src/**/*",
      "whats-new*.md",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Nagrands",
        "repo": "thunder-load-app",
        "releaseType": "release"
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "mp3",
          "m4a",
          "aac",
          "flac",
          "wav",
          "ogg",
          "opus"
        ],
        "name": "Thunder Audio",
        "description": "Audio media",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "mp4",
          "mkv",
          "webm",
          "mov",
          "avi",
          "mpeg",
          "mpg"
        ],
        "name": "Thunder Video",
        "description": "Video media",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "m3u",
          "m3u8"
        ],
        "name": "Thunder Playlist",
        "description": "Media playlist",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icons/app/app-icon.ico"
    },
    "nsis": {
      "perMachine": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icons/app/app-icon.png",
      "category": "Utility"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "assets/icons/platform/macos/app-icon.icns",
      "category": "public.app-category.utilities"
    },
    "dmg": {
      "writeUpdateInfo": false
    }
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/src/js/tests/setupTests.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Nagrands/thunder-load-app.git"
  },
  "bugs": {
    "url": "https://github.com/Nagrands/thunder-load-app/issues"
  },
  "keywords": [
    "downloader",
    "video",
    "audio",
    "tools",
    "ytdlp",
    "ffmpeg"
  ],
  "author": "NGR Software"
}
